# FORMA ARCHITECTS — NODEMAILER CONFIGURATION
# Recipient email where all turnkey project briefs and enquiries will be delivered
RECEIVING_EMAIL=venkatlokesh101@gmail.com

# Server Port
PORT=8080

# SMTP Sender Configuration (e.g. Gmail, Outlook, AWS SES, or Brevo/SendGrid)
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your normal password)
# How to get Google App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password
